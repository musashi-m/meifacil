{
  "manifest_version": 3,
  "name": "Facilita MEI - Emissor PGMEI & NFS-e Nacional",
  "version": "1.1.0",
  "description": "Preenchimento rápido do CNPJ no PGMEI e login automático com 1 clique no Portal da NFS-e Nacional da Receita Federal.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www8.receita.fazenda.gov.br/*",
    "https://www.nfse.gov.br/*",
    "https://brasilapi.com.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Facilita MEI",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www8.receita.fazenda.gov.br/simplesnacional/aplicacoes/atspo/pgmei.app/*",
        "https://www.nfse.gov.br/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}

